# Ignore node_modules (will be rebuilt in Docker)
node_modules/

# Ignore git
.git
.gitignore

# Ignore IDE files
.vscode/
.idea/
*.swp
*.swo

# Ignore documentation
*.md
docs/

# Ignore tests
__tests__/
*.test.js
*.spec.js

# Ignore build artifacts (except dist which is created during build)
dist/
.expo/
.expo-shared/

# Ignore environment files
.env
.env.*

# Ignore android/ios folders if not needed (Expo managed)
android/
ios/
