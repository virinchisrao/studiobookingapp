{
  "cli": {
    "version": ">=5.0.0",
    "appVersionSource": "remote"
  },
  "build": {
    "development": {
      "developmentClient": true,
      "distribution": "internal",
      "ios": {
        "simulator": true
      },
      "android": {
        "buildType": "apk",
        "distribution": "internal"
      }
    },
    "preview": {
      "distribution": "internal",
      "ios": {
        "simulator": true
      },
      "android": {
        "buildType": "apk",
        "distribution": "internal"
      }
    },
    "production": {
      "ios": {
        "bundleIdentifier": "com.studiobooking.app"
      },
      "android": {
        "buildType": "aab",
        "distribution": "store"
      }
    }
  },
  "submit": {
    "production": {
      "android": {
        "serviceAccountKeyPath": "/path/to/service-account-key.json"
      }
    }
  }
}
